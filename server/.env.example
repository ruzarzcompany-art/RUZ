# منفذ (server) — انسخ هذا الملف إلى .env وعدّل القيم

NODE_ENV=development
PORT=3000

# رابط الاتصال بقاعدة PostgreSQL (يدعم صيغة postgres:// أو متغيرات منفصلة أدناه)
DATABASE_URL=postgresql://user:password@localhost:5432/restaurant_hr
PGSSL=false

# مفاتيح أمنية — يجب تغييرها قبل الإنتاج وعدم مشاركتها
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=30d

# مفتاح تشفير قوالب الوجه (AES-256-GCM) — 32 بايت بصيغة hex (64 حرفاً)
FACE_ENC_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# حساب المدير الأول الذي يُنشأ مع الـ seed
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=change_this_password_now

# إعدادات الأمان
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
BCRYPT_ROUNDS=12

# الحضور بالموقع الجغرافي — أقصى مسافة مسموح بها بالأمتار من موقع الفرع (افتراضي إذا لم يُحدد للفرع)
DEFAULT_GEOFENCE_RADIUS_METERS=150

# CORS — روابط الواجهة المسموح بها (مفصولة بفاصلة)
CORS_ORIGINS=http://localhost:3000
